# Waveshare ESP32-S3-Touch-AMOLED-1.75C: 32 MB QIO flash and 8 MB octal PSRAM.
# These values match the official ESP-IDF example for this exact board.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
# Rodata stays in flash and is mapped from there. Copying it to PSRAM (IDF's
# XIP-from-PSRAM pairing with FETCH_INSTRUCTIONS) cost 4.3 MB of the 8 MB
# PSRAM for this image: that is the fonts, and it left 2.5 MB of PSRAM heap,
# which is less than the board's two full-height draw buffers (2 x 434 KB)
# plus its 2 MiB LVGL pool. PSRAM is the scarce pool here and flash is not
# (32 MB, 21% of the OTA slot free), so only the 1.3 MB of instructions is
# copied. Box text and glyphs come from the flash cache instead.
# CONFIG_SPIRAM_RODATA is not set
# Large zero-initialised UI state (both interface trees, the theme-switch
# replay buffers) is tagged EXT_RAM_BSS_ATTR so it does not eat internal RAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# The board port supplies its own PSRAM draw buffers and explicitly opts into
# direct PSRAM DMA. Keep a single outstanding QSPI transaction so old display
# frames cannot accumulate; the original BSP's default bounce buffers are not
# used by this board port.
CONFIG_BSP_LCD_TRANS_QUEUE_DEPTH=1
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# LVGL timing and the official BSP worker both use millisecond-scale scheduling.
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_DEF_REFR_PERIOD=25
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Creating the complete four-page LVGL instrument UI calls deeply into LVGL
# after the vendor BSP has initialized the display. The ESP-IDF default 3584
# byte app_main stack overflows during that one-time startup on real hardware.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# NimBLE is the phone transport. Bluetooth Classic is intentionally disabled
# on ESP32-S3 and not required by the navigation link.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# The central role only enables NimBLE's GATT client here (IDF 5.5 ties
# BT_NIMBLE_GATT_CLIENT to it). The device never scans or initiates; it reads
# the iPhone's Apple Media Service on the link the phone opened.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_GAP_SERVICE=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
# AMS notifications are parsed on the host task (strings, the MediaState copy
# handed to the bridge), on top of NimBLE's own frames; 4 KiB left no margin.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
# 185 is the practical iOS ATT MTU and fits NimBLE's standard mbuf pools.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185

# The 40 px CJK face in shared/nav_ui/assets exceeds the 1 MB glyph-bitmap
# limit; without this the firmware fails at compile time, not at link time.
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# The 2 MiB PSRAM pool below carries UI layers; the internal pool only
# serves small allocations. 32 KiB keeps internal DRAM free without the boot
# logo starve the old 64 KiB comment described.
CONFIG_LV_MEM_SIZE_KILOBYTES=8

# WiFi is an on-demand data plane to the iPhone hotspot (W0/W1 of
# docs/WAVESHARE_OPTIMIZATION_PLAN.md §4.5). Internal DRAM is the scarce pool,
# so the driver's dynamic buffers, lwIP and mbedTLS prefer PSRAM. Static RX
# buffers (~1.6 KB each, held from esp_wifi_init to esp_wifi_deinit) go from
# 10 to 6; the AMPDU RX window is pinned to the same 6 because the PSRAM
# option would otherwise raise it to 16, beyond the static buffers.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
# With the driver's hot paths in IRAM, linking WiFi alone cost 22 KB of the
# shared internal SRAM, all day, radio on or off: more than moving
# phone_bridge to PSRAM gave back. WiFi here is a bulk, occasional transfer,
# so the throughput loss is the cheaper side of the trade.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# OTA (W3). An image that boots but never completes a BLE handshake is rolled
# back by the bootloader on the next reset: the rider cannot plug the bike into
# a laptop at the roadside, so "it came up" is not proof enough on its own.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# A release URL is https. The common bundle covers the CAs that serve it and
# costs a fraction of the full one; the phone's hotspot server is plain http
# on the link and never touches this.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
