# Writes moto_build_info.h: the commit this image is built from, for
# FirmwareInfo (0x1E). Run on every build by the moto_build_info target in
# CMakeLists.txt, so a new commit or an edited tree is never reported with a
# stale hash, and the header is only rewritten when its text changes, so an
# unchanged tree recompiles nothing.
#
#   cmake -DREPO=<repository root> -DOUT=<header path> -P build_info.cmake
#
# The commit is `git rev-parse --short HEAD`, the same spelling
# scripts/publish_firmware.mjs puts in a release manifest's git_commit, with
# "-dirty" when tracked files have uncommitted changes. Outside a checkout it
# is "unknown".

execute_process(
    COMMAND git -C "${REPO}" rev-parse --short HEAD
    OUTPUT_VARIABLE build
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR build STREQUAL "")
    set(build "unknown")
else()
    execute_process(
        COMMAND git -C "${REPO}" status --porcelain --untracked-files=no
        OUTPUT_VARIABLE changes
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(NOT changes STREQUAL "")
        string(APPEND build "-dirty")
    endif()
endif()

set(text "#pragma once\n\n// Generated by build_info.cmake on every build. Do not edit.\n#define MOTO_FIRMWARE_BUILD \"${build}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" current)
    if(current STREQUAL text)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${text}")
