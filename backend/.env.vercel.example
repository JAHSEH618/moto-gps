# Vercel Functions deployment (Root Directory: backend).
# Set these in the Vercel dashboard (Project → Settings → Environment Variables);
# this file is only for the local stand-in: node --env-file=.env.vercel.example vercel/dev-server.js
#
# amap = live navigation. Without a key the gateway reports "disabled" and refuses
# live navigation instead of serving a fake route. fixture only replays a recorded
# response and is for protocol tests, never for riding.
MOTO_PROVIDER=amap
AMAP_WEB_SERVICE_KEY=REPLACE_WITH_YOUR_WEB_SERVICE_KEY

# Optional. Leave empty to use "auto" while MOTO_PROVIDER=amap, or "disabled" to turn
# the surrounding map off. A fixed URL must be an HTTPS .pmtiles archive with Range support.
# MOTO_MAP_PMTILES_URL=auto

# Optional. Only needed when a browser page (the web debug tool) calls this gateway.
# The native iOS app needs no CORS origin.
WEB_ORIGIN=

# Optional in-memory tile cache budget, per warm instance. Tiles are dropped with the
# instance; nothing is written to disk because serverless filesystems are read-only.
MOTO_MAP_CACHE_TILES=300
MOTO_MAP_CACHE_MAX_BYTES=67108864
