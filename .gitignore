.DS_Store
.env
.env.*
!.env.example
!backend/.env.vercel.example
build/
build-*/
tmp/
node_modules/
*.log
*.pem
*.key
*.p12
*.p8
*.mobileprovision
__pycache__/
*.pyc
platforms/esp32/managed_components/
platforms/esp32/sdkconfig
platforms/esp32/sdkconfig.old
platforms/esp32/sdkconfig.*.bak
platforms/ios/.build/
platforms/ios/.swiftpm/
platforms/ios/DerivedData/
platforms/ios/MotoGPS.xcodeproj/
**/xcuserdata/
*.xcuserstate
platforms/web/shell/runtime/
backups/
# The native C++ tests stay local. Anchored: with core.ignorecase a bare
# `tests/` would also hide platforms/ios/Tests. CMake, scripts/verify.sh and
# CI build and run them only where the directory exists.
/tests/
*.bin
*.elf
*.map

# Local Cloudflare emulator state (also when tests run from the repository root)
.wrangler/

# Agent skills are tracked in .agents/skills with skills-lock.json; other agents
# only get symlinks into that tree.
.claude/skills/

# Generated by build_moto_gps_proposal.py (A1) or exported from the DOCX (A0).
docs/technical-proposal/*.pdf
